  "sql": {
    "ambient_duckdb": "WITH ambient AS (\n      SELECT ((AMBIENT_ARCHIVE.epoch_ms) // 60000) AS minute_key,\n             MIN(AMBIENT_ARCHIVE.epoch_ms) AS minute_epoch_ms,\n             AVG(CAST(temperature AS DOUBLE)) AS ambient_value\n      FROM AMBIENT_ARCHIVE\n      WHERE AMBIENT_ARCHIVE.epoch_ms BETWEEN ? AND ?\n      GROUP BY minute_key\n    ), cpu AS (\n      SELECT ((DATA_ARCHIVE.epoch_ms) // 60000) AS minute_key,\n             AVG(CAST(cpu_temperature_avg AS DOUBLE)) AS cpu_value\n      FROM DATA_ARCHIVE\n      WHERE DATA_ARCHIVE.epoch_ms BETWEEN ? AND ?\n        AND cpu_temperature_avg IS NOT NULL\n      GROUP BY minute_key\n    )\n    SELECT ((ambient.minute_epoch_ms // ?) * ?) AS bucket_timestamp,\n           AVG(ambient_value) AS ambient_avg,\n           AVG(cpu_value - ambient_value) AS delta_avg,\n           COUNT(ambient_value) AS minute_count\n    FROM ambient\n    LEFT JOIN cpu ON cpu.minute_key = ambient.minute_key\n    GROUP BY 1\n    ORDER BY 1 ASC",
    "ambient_sqlite": "WITH ambient AS (\n      SELECT (((CAST(strftime('%s', AMBIENT_ARCHIVE.timestamp) AS INTEGER) * 1000 + CAST(substr(strftime('%f', AMBIENT_ARCHIVE.timestamp), 4, 3) AS INTEGER))) / 60000) AS minute_key,\n             MIN((CAST(strftime('%s', AMBIENT_ARCHIVE.timestamp) AS INTEGER) * 1000 + CAST(substr(strftime('%f', AMBIENT_ARCHIVE.timestamp), 4, 3) AS INTEGER))) AS minute_epoch_ms,\n             AVG(CAST(temperature AS REAL)) AS ambient_value\n      FROM AMBIENT_ARCHIVE\n      WHERE (CAST(strftime('%s', AMBIENT_ARCHIVE.timestamp) AS INTEGER) * 1000 + CAST(substr(strftime('%f', AMBIENT_ARCHIVE.timestamp), 4, 3) AS INTEGER)) BETWEEN ? AND ?\n      GROUP BY minute_key\n    ), cpu AS (\n      SELECT (((CAST(strftime('%s', DATA_ARCHIVE.timestamp) AS INTEGER) * 1000 + CAST(substr(strftime('%f', DATA_ARCHIVE.timestamp), 4, 3) AS INTEGER))) / 60000) AS minute_key,\n             AVG(CAST(cpu_temperature_avg AS REAL)) AS cpu_value\n      FROM DATA_ARCHIVE\n      WHERE (CAST(strftime('%s', DATA_ARCHIVE.timestamp) AS INTEGER) * 1000 + CAST(substr(strftime('%f', DATA_ARCHIVE.timestamp), 4, 3) AS INTEGER)) BETWEEN ? AND ?\n        AND cpu_temperature_avg IS NOT NULL\n      GROUP BY minute_key\n    )\n    SELECT ((ambient.minute_epoch_ms / ?) * ?) AS bucket_timestamp,\n           AVG(ambient_value) AS ambient_avg,\n           AVG(cpu_value - ambient_value) AS delta_avg,\n           COUNT(ambient_value) AS minute_count\n    FROM ambient\n    LEFT JOIN cpu ON cpu.minute_key = ambient.minute_key\n    GROUP BY 1\n    ORDER BY 1 ASC",
    "process": "SELECT\n  pid,\n  process_name,\n  AVG(cpu_usage) AS avg_cpu_usage,\n  AVG(memory_usage) AS avg_memory_usage,\n  MAX(execution_sec) AS total_execution_sec,\n  MAX(timestamp) AS latest_timestamp,\n  COUNT(*) AS diagnostic_count\nFROM PROCESS_STATS\nWHERE timestamp BETWEEN ? AND ?\nGROUP BY pid, process_name\nORDER BY avg_cpu_usage DESC"
  },
