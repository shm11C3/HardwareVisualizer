{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Frontend layer boundaries live in their own file; see its header.
  "extends": ["./.config/biome/frontend-boundaries.jsonc"],
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // TypeScript's noPropertyAccessFromIndexSignature requires bracket access for index signatures.
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {}
        }
      },
      "style": {
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error"
      }
    }
  },
  // Frontend file names match their export: components are PascalCase .tsx,
  // every other module is camelCase .ts. components/ui is the shadcn
  // generated kebab-case exception. A test mirrors its subject's name, so it
  // may be either. A later matching override replaces this rule's options
  // (not the boundary rules' options, which are a different rule). Keep the
  // exemptions last.
  "overrides": [
    {
      "includes": ["hardviz/frontend/src/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "filenameCases": ["PascalCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["hardviz/frontend/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "filenameCases": ["camelCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["hardviz/frontend/src/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "hardviz/frontend/src/**/*.test.ts",
        "hardviz/frontend/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "filenameCases": ["camelCase", "PascalCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "hardviz/frontend/src/main.tsx",
        "hardviz/frontend/src/main.e2e.tsx",
        "hardviz/frontend/src/**/*.d.ts",
        "hardviz/frontend/src/rspc/**"
      ],
      "linter": {
        "rules": { "style": { "useFilenamingConvention": "off" } }
      }
    },
    {
      // Biome (2.6.2+) fails to parse utilities it doesn't know that have a
      // dashed name and an arbitrary value, such as tailwindcss-animate's
      // `slide-out-to-top-[48%]`. Remove once this is fixed:
      // https://github.com/biomejs/biome/issues/12882
      "includes": ["hardviz/frontend/src/components/ui/dialog.tsx"],
      "linter": {
        "rules": { "nursery": { "useTailwindSortedClasses": "off" } }
      }
    }
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**",
      "!**/src/rspc",
      "!.codex",
      "!.claude",
      // Generated by scripts/licenses/generate-licenses.ts.
      "!docs/licenses/**/THIRD_PARTY_NOTICES.md"
    ]
  },
  // Lets the Tailwind rules read the theme, utilities, and variants.
  "tailwind": { "stylesheet": "./hardviz/frontend/src/index.css" },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  // Markdown formatting is adopted in stages: frontmatter parsing stays on so
  // `---` blocks are never rewritten as headings once the formatter is enabled.
  "markdown": {
    "parser": { "frontmatter": true },
    "formatter": { "enabled": false }
  }
}
