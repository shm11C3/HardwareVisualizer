{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Frontend layer boundaries live in their own file; see its header.
  "extends": ["./.config/biome/frontend-boundaries.jsonc"],
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // TypeScript's noPropertyAccessFromIndexSignature requires bracket access for index signatures.
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {}
        }
      },
      "style": {
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error"
      }
    }
  },
  // Frontend file names match their export: components are PascalCase .tsx,
  // every other module is camelCase .ts. src/components/ui is the shadcn
  // generated kebab-case exception. A test mirrors its subject's name, so it
  // may be either. A later matching override replaces this rule's options
  // (not the boundary rules' options, which are a different rule). Keep the
  // exemptions last.
  "overrides": [
    {
      "includes": ["src/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "filenameCases": ["PascalCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "filenameCases": ["camelCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "filenameCases": ["camelCase", "PascalCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/main.tsx",
        "src/main.e2e.tsx",
        "src/**/*.d.ts",
        "src/rspc/**"
      ],
      "linter": {
        "rules": { "style": { "useFilenamingConvention": "off" } }
      }
    },
    {
      // Biome 2.6.4's Tailwind parser rejects `%` in tailwindcss-animate
      // arbitrary values such as `slide-out-to-top-[48%]`.
      "includes": ["src/components/ui/dialog.tsx"],
      "linter": {
        "rules": { "nursery": { "useTailwindSortedClasses": "off" } }
      }
    }
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**",
      "!**/src/rspc",
      "!.codex",
      "!.claude",
      // Generated by .github/scripts/generate-licenses.ts.
      "!docs/licenses/**/THIRD_PARTY_NOTICES.md"
    ]
  },
  // Lets the Tailwind rules read the theme, utilities, and variants.
  "tailwind": { "stylesheet": "./src/index.css" },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  // Markdown formatting is adopted in stages: frontmatter parsing stays on so
  // `---` blocks are never rewritten as headings once the formatter is enabled.
  "markdown": {
    "parser": { "frontmatter": true },
    "formatter": { "enabled": false }
  }
}
