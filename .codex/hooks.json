{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.github/scripts/agent-hook.mjs\" pre",
            "timeout": 10,
            "statusMessage": "Checking generated-file guard..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.github/scripts/agent-hook.mjs\" post",
            "timeout": 30,
            "statusMessage": "Validating agent guidance..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.github/scripts/agent-hook.mjs\" stop",
            "timeout": 30,
            "statusMessage": "Checking complete agent guidance consistency..."
          }
        ]
      }
    ]
  }
}
