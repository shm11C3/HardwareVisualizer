                      "@/app/**",
                      "../**",
                      "jotai/**",
                      "!@/features/hardware/**"
                    ]
                  }
                ],
                "paths": {
                  "@/hooks/tauri/useTauriDialog": {
                    "message": "The hardware feature reports failures in place, never through an OS dialog. See the Failure Reporting section of docs/design/frontend-architecture.md.",
                    "importNames": ["*", "useTauriDialog"]
                  },
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
