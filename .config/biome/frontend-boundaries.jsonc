{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  // Frontend layer boundaries and state ownership (ADR 0027,
  // docs/design/frontend-architecture.md).
  //
  // A later override that configures a rule REPLACES that rule's options from
  // earlier overrides for the files it matches; options are not merged. Keep
  // the boundary scopes disjoint, keep every override's constraint set
  // complete, and keep the App override last so the app layer (src/app/**) is
  // reclassified after the generic scopes it overlaps.
  //
  // A target constraint that still has violations is recorded as a commented
  // entry tagged with the #2325 migration slice that removes it. None remain.
  // Never add a new pending exception to make new code pass.
  //
  // Plugin paths in this file resolve from the repository root (the config
  // that extends this file), not from this directory.
  "overrides": [
    // Module-scope `let` outside store modules.
    {
      "includes": [
        "src/**",
        "!src/**/store/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        // Process-wide handle to the Tauri Store plugin, not application state.
        "!src/lib/tauriStore.ts"
      ],
      "plugins": ["./.config/biome/no-module-scope-let.grit"]
    },
    // Foundation
    {
      "includes": [
        "src/lib/**",
        "src/types/**",
        "src/consts/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/hooks/**",
                      "@/components/**",
                      "@/store/**",
                      "@/app/**",
                      "../**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "jotai",
                      "jotai/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Shared store
    {
      "includes": ["src/store/**", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/hooks/**",
                      "@/components/**",
                      "@/app/**",
                      "../**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "jotai/react",
                      "jotai/react/**"
                    ]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider",
                      "useAtom",
                      "useAtomValue",
                      "useAtomValueRaw",
                      "useAtomValueRawSync",
                      "useSetAtom",
                      "useStore"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // Shared hooks
    {
      "includes": ["src/hooks/**", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/components/**",
                      "@/app/**",
                      "../**",
                      "jotai/**"
                    ]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider",
                      "atom"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // UI primitives
    {
      "includes": [
        "src/components/ui/**",
        "src/components/icons/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/hooks/**",
                      "@/store/**",
                      "@/components/charts/**",
                      "@/components/*",
                      "@/app/**",
                      "../**",
                      "jotai",
                      "jotai/**"
                    ]
                  }
                ],
                "paths": {
                  "@/rspc/bindings": {
                    "message": "UI primitives do not call IPC. See docs/design/frontend-architecture.md.",
                    "importNames": ["*", "commands", "events"]
                  }
                }
              }
            }
          }
        }
      }
    },
    // Shared components: charts
    {
      "includes": [
        "src/components/charts/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/components/*",
                      "@/app/**",
                      "../**",
                      "jotai/**"
                    ]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "atom",
                      "useAtom",
                      "useSetAtom",
                      "useStore",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // Shared components
    {
      "includes": [
        "src/components/*.ts",
        "src/components/*.tsx",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": ["@/features/**", "@/app/**", "../**", "jotai/**"]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "atom",
                      "useAtom",
                      "useSetAtom",
                      "useStore",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // Feature catch-all: a feature without its own overrides below fails here
    {
      "includes": [
        "src/features/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": ["@/features/**", "@/app/**", "../**", "jotai/**"]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "atom",
                      "useAtom",
                      "useSetAtom",
                      "useStore",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // Feature hardware: ui
    {
      "includes": [
        "src/features/hardware/**",
        "!src/features/hardware/store/**",
        "!src/features/hardware/hooks/**",
        "!src/features/hardware/**/hooks/**",
