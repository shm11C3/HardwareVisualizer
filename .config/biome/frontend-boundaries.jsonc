      }
    },
    // Feature tray: hooks
    {
      "includes": [
        "src/features/tray/hooks/**",
        "src/features/tray/**/hooks/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/components/**",
                      "@/app/**",
                      "../**",
                      "jotai/**",
                      "!@/features/tray/store/**",
                      "!@/features/tray/**/types",
                      "!@/features/tray/**/types/**",
                      "!@/features/tray/**/consts",
                      "!@/features/tray/**/consts/**",
                      "!@/features/tray/**/utils",
                      "!@/features/tray/**/utils/**",
                      "!@/features/tray/**/funcs",
                      "!@/features/tray/**/funcs/**",
                      "!@/features/tray/**/hooks/**"
                    ]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider",
                      "atom"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // Feature tray: store
    {
      "includes": [
        "src/features/tray/store/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/hooks/**",
                      "@/components/**",
                      "@/app/**",
                      "../**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "jotai/react",
                      "jotai/react/**",
                      "!@/features/tray/store/**",
                      "!@/features/tray/**/types",
                      "!@/features/tray/**/types/**",
                      "!@/features/tray/**/consts",
                      "!@/features/tray/**/consts/**",
                      "!@/features/tray/**/utils",
                      "!@/features/tray/**/utils/**",
                      "!@/features/tray/**/funcs",
                      "!@/features/tray/**/funcs/**"
                    ]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider",
                      "useAtom",
                      "useAtomValue",
                      "useAtomValueRaw",
                      "useAtomValueRawSync",
                      "useSetAtom",
                      "useStore"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // Feature updater: ui
    {
      "includes": [
        "src/features/updater/**",
        "!src/features/updater/store/**",
        "!src/features/updater/hooks/**",
        "!src/features/updater/**/hooks/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/app/**",
                      "../**",
                      "jotai/**",
                      "!@/features/updater/**"
                    ]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "atom",
                      "useAtom",
                      "useSetAtom",
                      "useStore",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // Feature updater: hooks
    {
      "includes": [
        "src/features/updater/hooks/**",
        "src/features/updater/**/hooks/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/components/**",
                      "@/app/**",
                      "../**",
                      "jotai/**",
                      "!@/features/updater/store/**",
                      "!@/features/updater/**/types",
                      "!@/features/updater/**/types/**",
                      "!@/features/updater/**/consts",
                      "!@/features/updater/**/consts/**",
                      "!@/features/updater/**/utils",
                      "!@/features/updater/**/utils/**",
                      "!@/features/updater/**/funcs",
                      "!@/features/updater/**/funcs/**",
                      "!@/features/updater/**/hooks/**"
                    ]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider",
                      "atom"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // Feature updater: store
    {
      "includes": [
        "src/features/updater/store/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": [
                      "@/features/**",
                      "@/hooks/**",
                      "@/components/**",
                      "@/app/**",
                      "../**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "jotai/react",
                      "jotai/react/**",
                      "!@/features/updater/store/**",
                      "!@/features/updater/**/types",
                      "!@/features/updater/**/types/**",
                      "!@/features/updater/**/consts",
                      "!@/features/updater/**/consts/**",
                      "!@/features/updater/**/utils",
                      "!@/features/updater/**/utils/**",
                      "!@/features/updater/**/funcs",
                      "!@/features/updater/**/funcs/**"
                    ]
                  }
                ],
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore",
                      "Provider",
                      "useAtom",
                      "useAtomValue",
                      "useAtomValueRaw",
                      "useAtomValueRawSync",
                      "useSetAtom",
                      "useStore"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    // App: the app layer (src/app/**), the composition root; keep this override last
    {
      "includes": ["src/app/**", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "message": "This import crosses a frontend layer boundary. See docs/design/frontend-architecture.md.",
                    "group": ["jotai/**"]
                  }
                ],
                // Provider is allowed here only: the composition root is the one place a store may be created, and only via <Provider>.
                "paths": {
                  "jotai": {
                    "message": "This Jotai API is not allowed in this layer. See docs/design/frontend-architecture.md.",
                    "importNames": [
                      "*",
                      "atom",
                      "useAtom",
                      "useSetAtom",
                      "useStore",
                      "createStore",
                      "INTERNAL_overrideCreateStore",
                      "getDefaultStore"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
